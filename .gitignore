__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
# Ornek dosya commit edilmeli — kurulum scripti bunu kaynak olarak kullaniyor
!.env.example
node_modules/
dist/
build/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python sanal ortamlari — makineye bagli, binlerce dosya.
.venv/
venv/

# TypeScript incremental build artefakti — her build'de degisir.
*.tsbuildinfo

# Yapay zeka araclarinin yerel calisma dizinleri (agent worktree'leri,
# oturum notlari). Ekip ayarlari `.claude/` altinda ayrica commit edilir.
.agents/
.codex/
.claude/worktrees/
memory/

# Claude Code — ekip ayarlari (.claude/settings.json, commands/, CLAUDE.md) commit edilir.
# Kisiye ozel local override ve gecici dosyalar commit edilmez.
.claude/settings.local.json

# Firebase Admin SDK service account dosyalari — ASLA commit edilmemeli
# (private key icerir). Backend runtime'da yerel dosyadan veya env ile okur.
fcm-service-account.json
**/fcm-service-account.json
**/*service-account*.json
**/firebase-adminsdk*.json

# Service Control Panel runtime config — INTERNAL_SERVICE_TOKEN ve diger
# secret degerleri icerebilir. Sadece `.example.json` template commit edilir;
# operator yerelde kopyalayip kendi degerlerini yazar.
infra/scripts/windows/service_control_panel.config.json
!infra/scripts/windows/service_control_panel.config.example.json

# NATS server config — bcrypt hash'leri bootstrap.sh tarafindan render edilir.
# Sadece `.template` commit edilir; gercek `.conf` `.env`'deki cleartext
# sifrelerin hash'lenmis halini icerir.
infra/nats/nats-server.conf
!infra/nats/nats-server.conf.template

# DB yedek dosyalari — ASLA commit edilmemeli (gercek musteri verisi icerir).
# Ankrasiz `backups/` yazmak cazip ama frontend'in `src/features/backups/`
# kaynak dizinini de yakalar; o yuzden yedek YAZILAN dizinler tek tek
# ankrali listelenir:
#   /backups/                  -> update.sh update oncesi otomatik yedek
#   /apps/backend-api/backups/ -> backup_service.py manuel/zamanli yedekler
# NOT: git .gitignore'da SATIR SONU yorumu desteklemez, pattern'in parcasi
# sayar. Yorumlar bu yuzden ayri satirlarda.
/backups/
/apps/backend-api/backups/
# Emniyet agi: yedek dosyalari nereye duserse dussun uzantidan yakalanir.
*.dump
*.sql.gz

# Runtime lisans verisi (installation-id, license.lic) — makineye baglidir,
# native backend calisinca LICENSE_DIR altinda olusur. Commit edilmez.
apps/backend-api/license-data/

# WhatsApp Web (Baileys) session/credential dosyalari — telefon eslesme
# bilgisi icerir, makineye/session'a ozeldir. Docker'da named volume ile
# kalici; native/yerel testte burada olusur, commit edilmez.
apps/whatsapp-web-gateway/session-data/

# Uretilen kurulum dosyalari — ICINDE CANLI ANAHTAR VAR, asla commit edilmez.
# (packaging/make-provisioner.sh uretir; varsayilan cikti dist/ zaten yok sayili)
enerjione-grid-kurulum*.sh
*-kurulum.sh
infra/appliance/provision.env

# Elle tutulan anahtar notlari — ASLA commit edilmez.
tokenler.txt
*token*.txt
*anahtar*.txt
