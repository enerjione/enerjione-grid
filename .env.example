# ----------------------------------------------------------------------
# EnerjiOne Grid Dashboard — Docker Compose ortam degiskenleri.
# Kullanim:
#   cp .env.example .env
#   ASAGIDAKI 4 SECRET'I MUTLAKA DEGISTIR (ornek: openssl rand -hex 32)
# ----------------------------------------------------------------------

# --- ZORUNLU: gizli degerler (uretim icin yeniden uret) ---
SECRET_KEY=please-change-me-32-bytes-hex
INTERNAL_SERVICE_TOKEN=please-change-me-internal-32-bytes-hex
POSTGRES_PASSWORD=change-me-strong-password
RABBITMQ_PASSWORD=change-me-strong-password

# --- Image registry + versioning ---
# Servis image'lari `${E1_REGISTRY}/<servis>:${E1_VERSION}` ile cozulur.
# Varsayilan registry GHCR: imajlari release CI derler ve buraya basar; saha
# cihazi derleme YAPMAZ, sadece indirir. Boylece her cihazda bit-bit ayni
# imaj calisir ve kurulum dakikalar yerine saniyeler surer.
#
# Yerel gelistirmede kendi build'inizi kullanmak icin:
#   E1_REGISTRY=e1-grid        (docker compose build ile bu isimle taglanir)
E1_REGISTRY=ghcr.io/enerjione/enerjione-grid

# Production'da HER ZAMAN explicit semver kullanin (rollback icin sart):
#   E1_VERSION=2.25.0
# 'latest' rollback imkani birakmaz — bozuk bir imaj push edilirse tum sistem
# etkilenir. Semver tag'de onceki imaj docker'da durur ve
# `E1_VERSION=2.24.4 docker compose up -d` ile aninda geri donulur.
# update.sh bu degeri checkout edilen release tag'inden otomatik yazar.
E1_VERSION=latest

# --- GHCR erisimi (private paket) ---
# Repo private oldugu icin imajlar da private. Saha cihazi imaji cekebilmek
# icin salt-okunur (read:packages) bir token ile ghcr.io'ya login olur.
# install.sh bu degeri sorar ve buraya yazar; sonrasinda update.sh kullanir.
# Token SADECE paket okuyabilmeli — repo yazma yetkisi ASLA verilmemeli.
GHCR_USERNAME=
GHCR_TOKEN=

# --- Guncelleme kontrolu (SADECE BILGI) ---
# Lisans / Sistem Durumu sayfalari "yeni surum var" ibaresi gosterir.
# Arayuzden guncelleme BASLATILAMAZ; guncelleme update.sh ile yapilir.
# Bos ise kontrol tamamen kapalidir.
#
# Depo private oldugu icin GitHub Releases API kimliksiz kullanilamaz;
# bunun yerine kendi sunucumuzdaki manifest okunur (bkz.
# infra/scripts/linux/publish-installer.sh):
#   UPDATE_CHECK_URL=https://enerjione.com/grid/version.json
UPDATE_CHECK_URL=
UPDATE_CHECK_INTERVAL_SEC=21600

# --- Frontend public URL (davet email + linkler icin) ---
# Backend yeni user davet ettiginde mail icindeki linki tam URL olarak
# uretebilmesi icin gereklidir. Bos birakirsa setup linki relative path
# ('/setup-password?token=...') doner; admin elle host ekleyip kullaniciya
# iletmek zorunda.
# Ornek: http://192.168.1.10 veya http://grid.local
FRONTEND_BASE_URL=

# --- Off-site backup (opsiyonel) ---
# Yedek dosyalari icin ikincil dizin (NAS share, ikinci disk vb.). Bos ise
# off-site kopya yapilmaz. Disk-failure / kriptolocker durumunda fiziksel
# olarak ayri kopya kalir.
# Windows:  BACKUP_OFFSITE_DIR=\\nas\backups\enerjione-grid
# Linux:    BACKUP_OFFSITE_DIR=/mnt/nas/backups/enerjione-grid
#
# DOCKER KURULUMUNDA: burada verilen HOST yolu container'a AYNI yol ile
# baglanir (docker-compose.yml backend-api volumes). Iki sart var:
#   1) Yol container BASLAMADAN ONCE host'ta mount edilmis olmali. Aksi halde
#      Docker bos bir dizin yaratir ve "off-site" kopya ayni diske yazilir.
#   2) Dizin uid 10001 (backend kullanicisi) tarafindan yazilabilir olmali.
# Degistirdikten sonra: docker compose up -d backend-api
BACKUP_OFFSITE_DIR=

# --- Backup restore icin non-superuser PG rolu (CR2 RCE koruma) ---
# pg_restore default olarak POSTGRES_USER (superuser) ile kosar; yedek
# dosyasi `COPY FROM PROGRAM` veya `CREATE FUNCTION LANGUAGE c` gibi
# RCE vektorleri icerebilir. Bunu engellemek icin DB'de non-superuser
# rolu olusturun ve burada belirtin:
#   CREATE ROLE e1_restore NOSUPERUSER LOGIN PASSWORD 'strong-password';
#   GRANT ALL PRIVILEGES ON DATABASE enerjione_grid TO e1_restore;
#   GRANT ALL ON SCHEMA public TO e1_restore;
# Bos birakilirsa POSTGRES_USER kullanilir (geriye uyumlu ama RCE riski acik).
POSTGRES_RESTORE_USER=
POSTGRES_RESTORE_PASSWORD=

# --- Postgres ---
POSTGRES_DB=enerjione_grid
POSTGRES_USER=enerjione_grid

# --- RabbitMQ (sadece alarm.created akisi icin) ---
RABBITMQ_USER=e1

# --- NATS JetStream (telemetri akisinin PRIMARY rotasi) ---
# Backend startup'ta stream'leri otomatik olusturur (TELEMETRY_RAW,
# TELEMETRY_NORMALIZED). Telemetri akisi tamamen JetStream uzerinden gider;
# RabbitMQ sadece alarm.created icin kullanilir.
#
# AUTH: NATS server `infra/nats/nats-server.conf`'ta uc kullanici tanimli:
#   - gateway: e1.telemetry.raw.> publish (saha cihazlari)
#   - backend: stream yonetimi + tum subject'lere full access
#   - worker:  tag-engine / alarm-service / iec104-outbound
#
# Bu sifreleri uretmek icin:
#   docker run --rm -it nats:2.10-alpine nats server passwd
# Bcrypt hash'i nats-server.conf'a yazilir, cleartext aynisi buraya .env'e.
NATS_BACKEND_PASSWORD=please-change-me-backend-nats-password
NATS_WORKER_PASSWORD=please-change-me-worker-nats-password
NATS_GATEWAY_PASSWORD=please-change-me-gateway-nats-password
# Backend/worker icinde kullanilan URL'ler — uygun user/password ile.
NATS_URL_BACKEND=nats://backend:${NATS_BACKEND_PASSWORD}@nats:4222
NATS_URL_WORKER=nats://worker:${NATS_WORKER_PASSWORD}@nats:4222
# Geriye uyumluluk (eski .env'lerden): NATS_URL set edilmediyse backend
# kendi URL'sine duser. Production'da NATS_URL_BACKEND kullanilir.
NATS_URL=${NATS_URL_BACKEND}

# --- Backend ---
# Browser'in cati yazilima erisecegi origin(ler). install.sh deploy zamani
# VPS IP'sini otomatik ekler. Production'da '*' YASAK (config.py guard).
# Birden fazla origin virgulle ayir, orn:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost,http://127.0.0.1
# APP_ENV production icin guvenlik guard'lari devreye girer (config.py
# _validate_production_safeguards). Dev'de 'development' yapin.
APP_ENV=production
# Oturum omru (dakika). 1440 = 24 saat — saha vardiyasi boyunca tekrar giris
# istemeyecek kadar uzun, gunluk rotasyonu koruyacak kadar kisa.
#
# "Beni hatirla" ISARETLENIRSE backend AYRI ve daha uzun bir TTL kullanir
# (REMEMBER_ME_TOKEN_MINUTES, varsayilan 30 gun). Bu yuzden buraya 43200
# yazmayin: kutucugu isaretlemeyen kullaniciya da 30 gunluk token verir ve
# "beni hatirla" ayrimini tamamen anlamsizlastirir.
ACCESS_TOKEN_MINUTES=1440

# Cihaz bazli offline lisans. Docker defaults compose icinde tanimli; native
# backend calistiriyorsaniz kalici bir dizin verin. Makine kimligi USB/disk/MAC
# degil, sabit OS kimligidir; donanim eklemek lisansi bozmaz.
LICENSE_DIR=./license-data
HOST_MACHINE_ID_PATH=/run/host-machine-id

# --- Retention / TTL: "disk asla dolmamali" ---------------------------------
# Sinirsiz buyuyen tablolarin zaman/adet bazli temizligi. Tum degerlerin tek
# kaynagi apps/backend-api/app/core/config.py; buradaki degerlerle senkronu
# tests/test_config_consistency.py kilitler (uc dosya birlikte guncellenir).

# telemetri (canli deger tablosu) — DB'de tutulan pencere (dakika).
# Her (cihaz, sinyal) ikilisinin SON degeri retention'dan MUAFTIR; bu sure
# kisa olsa bile canli degerler ekrani bosalmaz.
TELEMETRY_RETENTION_MINUTES=30
TELEMETRY_RETENTION_INTERVAL_SEC=300

# idempotency defteri (processed_messages) — ayni mesaj iki kez islenmesin.
# Gercek redelivery penceresi ack_wait(60sn) x max_deliver(10) = 10 DAKIKA,
# ustelik telemetry_history dogal anahtarinda ikinci bir dedup katmani var.
# 24 saat bu ihtiyacin 144 kati. (Onceki 7 GUNluk deger tabloyu 600 cihaz
# olceginde ~180M satira cikariyordu.)
PROCESSED_MESSAGES_RETENTION_HOURS=2
PROCESSED_MESSAGES_INTERVAL_SEC=600

# olay/denetim kaydi (system_events) — 2 yil saklanir, sonra en eskiler duser.
# MAX_ROWS: adet tavani. Beklenmedik bir olay firtinasinda 2 yil DOLMADAN da
# devreye girer ve en eski kayitlari duser (FIFO emniyet subabi). 0 = kapali.
SYSTEM_EVENTS_RETENTION_DAYS=730
SYSTEM_EVENTS_INTERVAL_SEC=21600
SYSTEM_EVENTS_MAX_ROWS=5000000

# Retention DELETE'leri LIMIT'li TURLAR halinde kosar. Tek transaction'da
# milyonlarca satir silmek WAL'i sisirir, tabloyu kilitler ve autovacuum'u
# geride birakir. BATCH = tur basina satir, MAX_BATCHES = bir tetikteki tur
# tavani (artan satirlar bir sonraki tetikte silinir).
RETENTION_DELETE_BATCH=20000
RETENTION_MAX_BATCHES_PER_RUN=50

# --- Disk guard: son emniyet subabi -----------------------------------------
# Yukaridaki TTL'ler ve asagidaki NATS/yedek/harita tavanlari "normalde
# dolmaz" garantisi verir. Disk guard ise "tavanlardan biri YANLIS
# hesaplanmis olsa bile disk DOLMASIN" garantisidir: hicbir tavana guvenmez,
# gercek bos alani olcer.
#
# rezerv = max(toplam_disk x YUZDE, MIN_GB)
#   Yuzde tabanli cunku disk boyutu kurulumdan kuruluma degisir (saha
#   standardi 500 GB). Sabit bir GB degeri kucuk diskte sistemi bogar,
#   buyuk diskte alani bosa yatirir. MIN_GB cok kucuk disklerde yuzdenin
#   yetersiz kalmasini onler (Postgres VACUUM/pg_dump calisma alani ister).
#
# Seviyeler (bos alanin rezerve orani):
#   >= 2x rezerv -> ok      : hicbir sey yapilmaz
#   >= 1x rezerv -> uyari   : loglanir + olay kaydi. SILME YOK.
#   >= 0.5x      -> agresif : retention'lar kisaltilmis pencereyle hemen kosar
#   <  0.5x      -> acil    : + yeniden uretilebilirler silinir
#                             (harita onbellegi, fazla yedekler)
#
# ASLA silinmeyenler: denetim kaydi, lisans, ayarlar, alarm/ariza gecmisi ve
# musterinin analiz verisi (telemetry_history + ozetleri). Acil seviyede bile
# historian OTOMATIK budanmaz; operatore kritik uyari yazilir.
DISK_GUARD_ENABLED=true
DISK_GUARD_RESERVE_PERCENT=10
DISK_GUARD_RESERVE_MIN_GB=5
DISK_GUARD_INTERVAL_SEC=300
DISK_GUARD_EMERGENCY_BACKUP_KEEP=2
# Olculecek yol. Bos ise BACKUP_DIR kullanilir (gercek bir volume mount'u,
# container'in `/` overlay'inden daha dogru gosterge).
DISK_GUARD_PATH=

# --- Canli deger yayini (WebSocket fan-out) ---------------------------------
# Yayin NATS uzerinden gider ve HER backend sureci abone olup kendi yerel WS
# istemcilerine dagitir. Tek surecte davranis aynidir; coklu surece (API
# worker'lari + ayri tuketici container'i) gecildiginde ZORUNLUDUR — kopru
# olmadan tuketici baska surecte oldugu icin WS istemcilerine hicbir sey
# ulasmaz ve bu ariza SESSIZDIR (soket bagli gorunur, deger akmaz).
#
# Kopru kurulamazsa yayin bellek-ici yola duser; tek surecli kurulum NATS
# olmadan da tam calisir. Kapatmak icin: false (acil kill switch).
WS_FANOUT_NATS_ENABLED=true
# Core NATS subject'i (JetStream DEGIL — canli deger efemer, kalicilik/ack/disk
# maliyeti odemenin karsiligi yok).
WS_FANOUT_SUBJECT=e1.ws.telemetry

# --- NATS JetStream disk tavani (stream basina, BAYT) -----------------------
# max_age bir ZAMAN siniridir, disk sinirini GARANTI ETMEZ (disk = hiz x zaman).
# Bu tavanlar olmadan tek fren nats-server.conf'taki hesap seviyesi
# max_file_store idi; o da budama yapmaz, dolunca publish REDDEDILIR ve
# telemetri akisi DURUR.
#
# Backend bu tavanlari her boot'ta idempotent uygular ve discard=old ile
# birlikte kullanir: tavana carpinca EN ESKI mesajlar duser, akis DEVAM EDER.
# Uzun bir kesintide (raw icin ~19 saat) o donemin en eski mesajlari sessizce
# kaybolur — bilincli takas, oncelik "sistem asla durmasin".
#
# Toplam 12 GiB. nats-server.conf max_file_store bunun USTUNDE kalmali.
NATS_STREAM_RAW_MAX_BYTES=8589934592
NATS_STREAM_NORMALIZED_MAX_BYTES=3221225472
NATS_STREAM_DLQ_MAX_BYTES=1073741824

# --- Alarm reconcile / rate historian ---
# Alarm reconcile dongusu araligi (saniye) — acik alarmlari kaynak degerle
# karsilastirir. Ayni tick'te cihaz bazli "alarm sikligi" (rate) historian'a
# yazilir (master.alarm_rate sinyali), heatmap/trend icin surekli seri.
ALARM_RECONCILE_INTERVAL_SEC=30
# Alarm rate penceresi (dakika): son N dakikadaki alarm sayisi. Default 1.
ALARM_RATE_WINDOW_MIN=1

# --- Frontend ---
# Public HTTP portu. Domain + 443 kullanacaksan TLS terminator'u disardan
# (Caddy/Traefik/Cloudflare) yapip 80'i icerdeki olarak birak.
#
# COKLU UYGULAMA (subdomain routing): Host'a nginx kurup birden fazla
# uygulamayi (orn. EnerjiOne Grid + EnerjiOne Solar) yan yana calistirmak
# istersen FRONTEND_HTTP_PORT=127.0.0.1:8080 yap. Container disariya bind
# olmaz; host nginx 80'i alir ve server_name'e gore proxy eder. Detayli
# rehber: infra/host-nginx/README.md
FRONTEND_HTTP_PORT=80

# --- SMTP (opsiyonel, e-posta bildirimleri icin) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@enerjione-grid.local

# --- Gomulu FTP sunucusu (cihaz config/firmware transfer) ---
# Horstmann SN2 cihazlari config dosyalarini bu sunucuya yazar. Cihaz FTP
# ekranina bu bilgiler girilir (Server=VDS IP, Port=21, User/Pass=asagidaki).
# FTP_PASSWORD bos birakilirsa sunucu BASLAMAZ (SystemExit(2)) ve Docker onu
# sonsuza kadar yeniden baslatir. Bu yuzden install.sh/update.sh degeri bos
# bulursa 16 haneli rastgele bir parola URETIR ve kurulum ozetinde gosterir;
# burayi elle doldurmak gerekmez. Elle bir deger yazarsaniz KORUNUR.
FTP_USER=device
FTP_PASSWORD=
# Kontrol portu host'ta (cihaz buraya baglanir). Genelde 21.
FTP_HOST_PORT=21
# Pasif mod veri portu araligi — cihazlar pasif moddaysa bu aralik da acik olmali.
FTP_PASV_MIN_PORT=30000
FTP_PASV_MAX_PORT=30009
# NAT arkasindaysa cihazin gordugu dis IP (bos = otomatik). Genelde VDS public IP.
FTP_MASQUERADE_ADDRESS=

# --- Uzaktan bakim VPN'i (Tailscale) ---------------------------------------
# Doluysa cihaz KURULUMDA OTOMATIK olarak tailnet'e katilir; saha PC'sine
# port acmadan (NAT arkasindan) uzaktan bakim yapilabilir.
# Bos birakilirsa VPN adimi hic calismaz — anahtarsiz kurulum etkilenmez.
#
# Iki tur anahtar da kabul edilir:
#   tskey-auth-...    reusable + pre-approved auth key
#   tskey-client-...  OAuth client secret (etiket ZORUNLU, anahtar otomatik uretilir)
#
# SIFIR DOKUNUSLU KURULUM: anahtari /etc/enerjione-grid/install.env icine
# koyarsan install.sh onu otomatik bulur ve bu dosyaya yazman gerekmez.
# Detay: docs/TAILSCALE.md
#
# UYARI: Bu deger bir TAILNET ANAHTARIDIR. Repoya commit ETMEYIN (.env zaten
# .gitignore'da). Sizinti durumunda Tailscale konsolundan hemen iptal edin.
E1_TAILSCALE_AUTHKEY=
# Cihaz etiketi — tailnet ACL'inde erisim yetkisi buna gore verilir.
E1_TAILSCALE_TAGS=tag:e1-appliance
# Tailscale SSH (1=acik). Erisim ayri anahtar gerektirmez, ACL ile kontrol edilir.
E1_TAILSCALE_SSH=1
# Tailnet DNS'ini kabul et (0 onerilir: saha cihazinin yerel DNS'i bozulmasin).
E1_TAILSCALE_ACCEPT_DNS=0

# --- Yedek temizligi --------------------------------------------------------
# BACKUP_MANUAL_RETENTION_DAYS: manuel/yuklenen yedekler icin yas bazli
# temizlik. 0 = KAPALI (varsayilan) — bilincli tercih: operatorun "buyuk
# degisiklik oncesi" diye elle aldigi bir yedek habersiz silinmemeli.
# Zamanlanmis yedekler zaten yedekleme ayarlarindaki `retention_count` ile
# sinirli. Disk ACIL seviyeye gelirse disk_guard bu ayardan bagimsiz olarak
# fazla yedekleri temizler, yani "disk dolmasin" garantisi 0 ile de korunur.
# Duzenli temizlik isteyen operator 90 gibi bir deger verir.
BACKUP_MANUAL_RETENTION_DAYS=0
# Basarisiz yedek kayitlari ve yarim kalmis .dump dosyalari KOSULSUZ silinir
# (yarim dosya geri yuklenemez, sadece yer kaplar). En yeni BASARILI yedek
# her kosulda korunur.
BACKUP_FAILED_RETENTION_DAYS=7
