# EnerjiOne Grid Dashboard — NATS JetStream server konfigurasyonu.
#
# Bu dosya docker-compose `nats` servisinde read-only mount edilir:
#   - ./infra/nats/nats-server.conf:/etc/nats/nats-server.conf:ro
# Compose `command`: `-c /etc/nats/nats-server.conf -js --store_dir=/data ...`
#
# Auth modeli:
#   * `gateway` user: gateway'ler `e1.telemetry.raw.>` subject'ine publish eder.
#       Sadece raw subject yetkisi; normalized/event'lere yazamaz.
#   * `backend` user: backend-api raw'i consume + normalized'i consume +
#       stream yonetimi (ensure, update). Tam yetki.
#   * `worker` user: tag-engine + alarm-service + iec104-outbound. Normalized
#       publish (tag-engine) ve subscribe (alarm/iec104).
#
# Production'da bu dosya secret degerlerle override edilmeli. Sifreler
# `${NATS_*_PASSWORD}` env-substituted DEGIL — nats-server.conf bunu
# desteklemiyor. Operator deploy oncesi gercek hash'lerle dolduruyor;
# `.gitignore`'da nats-server.conf private varyantlar engellenir.

server_name: e1-nats-1
http_port: 8222

jetstream {
    store_dir: "/data"
    # HESAP SEVIYESI ACIL TAVAN — MUTLAK bayt siniri (diskin yuzdesi DEGIL).
    #
    # Eskiden buradaki yorum "disk'in %95'i dolarsa" diyordu; bu YANLISTI ve
    # yanlis guven veriyordu: bu deger diskin ne kadar dolu oldugundan
    # tamamen bagimsiz mutlak bir tavandir. Tavan kadar bos alan yoksa NATS
    # kendi tavanina ULASMADAN once HOST DISKINI doldurur (nats-data ve
    # postgres-data ayni dosya sisteminde -> Postgres de duser).
    #
    # AYRICA: hesap tavani BUDAMA yapmaz — dolunca publish REDDEDILIR ve
    # telemetri akisi durur. Bu yuzden asil sinir burasi DEGIL, stream basina
    # `max_bytes` + `discard=old` olmali (bkz. config.py nats_stream_*_max_bytes
    # ve services/jetstream_bus.py). Backend bunlari her boot'ta idempotent
    # uygular; toplam 10 GiB (raw 6 + normalized 3 + dlq 1).
    #
    # 50GB -> 12GB. Eski deger bir emniyet subabi DEGILDI: saha cihazinda o
    # kadar bos alan hicbir zaman olmadigi icin NATS kendi tavanina ULASMADAN
    # once host diskini doldururdu — yani subap hic calismazdi. Emniyet
    # subabinin ise yaramasi icin iki sarti birden saglamasi gerekir:
    #   (1) stream tavanlari toplaminin USTUNDE  -> 12e9 > 10 GiB (10,74e9)
    #   (2) cihazin bos diskinin ALTINDA         -> 12 GB her sahada gecerli
    # Stream tavanlarini buyutursen bunu da buyutmen gerekir; kucultursen once
    # bu carpar ve sert red geri gelir.
    #
    # NOT: NATS'ta 'GB' = 10^9 (GiB degil). tests/test_config_consistency.py
    # karsilastirmayi bu birimle yapiyor.
    max_file_store: 12GB
    max_memory_store: 1GB
}

# Authorization — placeholder sifreler. Production'da bcrypt hash zorunlu:
#   nats server passwd
#   (veya `nats-server -DV` ile dogrula).
# `bcrypt` format: `$2a$...` ile basliyor. Cleartext sifre kullanmayin —
# bu dosya repo'ya commit'lenebildigi icin hash sart.
authorization {
    # Default permissions: hicbiri (deny-all). Acik yetki gerekli.
    default_permissions = {
        publish = { deny = [">"] }
        subscribe = { deny = [">"] }
    }

    users = [
        {
            user: "gateway"
            # bootstrap.sh tarafindan render edilir — `.env`'deki cleartext
            # NATS_GATEWAY_PASSWORD'i bcrypt'leyip bu placeholder'a yazar.
            password: "{{NATS_GATEWAY_BCRYPT_HASH}}"
            permissions = {
                # Gateway'ler sadece raw telemetri publish edebilir.
                publish = {
                    allow = [
                        "e1.telemetry.raw.>"
                    ]
                }
                # Gateway hicbir subject'i dinlemez (telemetri tek yon).
                # `_INBOX.>` connect/ping icin gerekli.
                subscribe = {
                    allow = ["_INBOX.>"]
                }
            }
        },
        {
            user: "backend"
            password: "{{NATS_BACKEND_BCRYPT_HASH}}"
            permissions = {
                # Backend stream yonetimi + tum subject'lere full access.
                publish = { allow = ["e1.>", "$JS.>"] }
                subscribe = { allow = ["e1.>", "_INBOX.>", "$JS.>"] }
            }
        },
        {
            user: "worker"
            password: "{{NATS_WORKER_BCRYPT_HASH}}"
            permissions = {
                # Tag-engine raw subscribe + normalized publish.
                # Alarm-service / iec104-outbound normalized subscribe.
                #
                # JetStream API izinleri: worker'lar consumer create/delete +
                # stream metadata sorgulama yapabilmeli. Aksi halde
                # `permissions violation for publish to $JS.API.STREAM.NAMES`
                # alirlar (subscribe oncesi "stream var mi?" sorgu). Stream
                # YONETIMI (add/update/delete) backend'e ozel; worker'lar
                # sadece OKU + consumer baglan.
                publish = {
                    allow = [
                        "e1.telemetry.normalized.>",
                        "$JS.API.CONSUMER.>",
                        "$JS.API.STREAM.NAMES",
                        "$JS.API.STREAM.LIST",
                        "$JS.API.STREAM.INFO.>",
                        "$JS.API.STREAM.MSG.GET.>",
                        "$JS.ACK.>"
                    ]
                }
                subscribe = {
                    allow = [
                        "e1.telemetry.raw.>",
                        "e1.telemetry.normalized.>",
                        "_INBOX.>",
                        "$JS.>"
                    ]
                }
            }
        }
    ]
}

# TLS — kurulum tarafindan render edilir.
#
# `NATS_TLS_ENABLED=true` ise install.sh/update.sh asagidaki isareti gercek bir
# `tls { ... }` blogu ile degistirir; degilse yorum satiri birakir.
#
# NEDEN OPT-IN: TLS acildiginda TUM istemciler (backend, 4 worker ve
# gateway'ler) `tls://` + CA dosyasi ile baglanmak zorunda. Biri eksik kalirsa
# telemetri akisi DURUR. Bu yuzden acilis iki bilincli adim: once
# `infra/scripts/linux/nats-tls-setup.sh` ile sertifika uret, sonra bayragi ac.
#
# `verify: true` KULLANILMIYOR — o, istemcinin de sertifika sunmasini (mTLS)
# zorunlu kilar. Kimlik dogrulama zaten kullanici+parola ile yapiliyor; TLS'in
# buradaki isi kanali sifrelemek ve sunucuyu dogrulatmak. mTLS'e gecmek her
# gateway icin ayri sertifika dagitimi/yenilemesi demek olurdu.
{{NATS_TLS_BLOCK}}

# Limit DoS:
max_payload: 1MB
max_connections: 1000
