[Unit]
# Host'un guncel ag durumunu state.json'a yazar; backend bu dosyayi okuyup
# UI'da gosterir (container'in host agina erisimi yok).
Description=EnerjiOne Grid ag durumu raporlayici
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/opt/enerjione-grid/infra/appliance/e1-netd.py report
SuccessExitStatus=0 1
# Rapor turu okuma agirlikli, ama gerektiginde AP'yi acar veya kayitli aga
# yeniden baglanmayi dener (nmcli connection up 25-45 sn surebilir).
# Bu yuzden 60 sn dar kaliyordu.
TimeoutStartSec=120
# nmcli durum metinlerini yerellestirir; ajan da kendi icinde LC_ALL=C
# zorluyor ama unit tarafinda da sabitlemek ucuz bir emniyet.
Environment=LC_ALL=C
Environment=LANG=C

[Install]
WantedBy=multi-user.target
