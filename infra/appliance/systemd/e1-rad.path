[Unit]
Description=EnerjiOne Grid uzaktan bakim istegi izleyici

[Path]
# Backend container bu dosyayi yazinca e1-rad.service tetiklenir.
# PathExists + PathChanged birlikte: dosya yeni olusturulduysa da, uzerine
# yazildiysa da yakalanir (geri alma istegi bekleyeni EZER).
PathExists=/var/lib/e1-grid/remote/request.json
PathChanged=/var/lib/e1-grid/remote/request.json
Unit=e1-rad.service

[Install]
WantedBy=multi-user.target
