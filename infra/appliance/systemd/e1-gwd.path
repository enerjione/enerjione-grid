[Unit]
Description=EnerjiOne Grid gateway kurulum istegi izleyici

[Path]
# Backend container bu dosyayi yazinca e1-gwd.service tetiklenir.
# PathExists + PathChanged birlikte: dosya yeni olusturulduysa da,
# uzerine yazildiysa da yakalanir.
PathExists=/var/lib/e1-grid/gw/request.json
PathChanged=/var/lib/e1-grid/gw/request.json
Unit=e1-gwd.service

[Install]
WantedBy=multi-user.target
