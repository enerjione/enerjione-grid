APP_NAME=EnerjiOne Grid API
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=change-this-key
ALGORITHM=HS256
# Oturum omru DAKIKA cinsinden. 1440 = 24 saat (config.py varsayilani ile ayni).
# Buradaki deger 30 idi — yani yarim saat; saha kullanicisini surekli login
# ekranina atiyordu. "Beni hatirla" icin ayri REMEMBER_ME_TOKEN_MINUTES var.
ACCESS_TOKEN_MINUTES=1440
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enerjione_grid
CORS_ORIGINS=http://localhost:5173

# Sistem Durumu > Servis durumlari: bu kurulumda bulunmayan servisleri listeden
# tamamen cikarir (virgulle ayrilir). Native dev'de frontend vite ile calisir
# (nginx yok) ve ftp-server kurulu olmayabilir; aksi halde surekli kirmizi
# gorunup gercek arizayi golgelerler.
# Anahtarlar: database, rabbitmq, nats, frontend_web, tag_engine, alarm_service,
#             notification_worker, iec104_outbound, ftp_server, whatsapp_web_gateway
# SYSTEM_STATUS_SKIP_SERVICES=frontend_web,ftp_server

# --- Surec rolu (olcekleme) ---
# Backend sureci HTTP'nin yaninda 12 arka plan isi calistirir (telemetri
# tuketicisi, outbox, MQTT, toplu bildirim, retention, alarm mutabakati,
# yedekleme, IEC 104 sunuculari). Bunlarin TAMAMI tekil olmalidir.
#
#   all    (VARSAYILAN) tek container: HTTP + arka plan. Bugunku davranis.
#   api    yalnizca HTTP/WS. Arka plan isi ACMAZ; coklu uvicorn worker guvenli.
#   worker yalnizca arka plan isleri.
#
# Ayirmak isteyen kurulum: backend-api'ye `api`, ayri bir backend-worker
# servisine `worker` verir (bkz. docker-compose.yml). Ayirmazsaniz hicbir sey
# yapmaniza gerek yok.
#
# GUVENLIK AGI: rol yanlis verilse bile isler iki kez KOSMAZ — lider secimi
# Postgres advisory lock ile yapilir.
# SERVICE_ROLE=all

# Arka plan surecinin IC ag adresi. YALNIZCA `SERVICE_ROLE=api` iken okunur.
# Telemetri tuketicisinin sayaclari surec icidir; Sistem Durumu sayfasindaki
# "telemetri boru hatti" olcumu (backlog / mesaj-sn) bu adresten alinir.
# Yanlissa sayfa "Arka plan surecine ulasilamiyor" der — sahte yesil GOSTERMEZ.
# BACKEND_WORKER_HOST=backend-worker
# BACKEND_WORKER_PORT=8000

# --- Surum / guncelleme bilgisi (Lisans + Sistem Durumu sayfalari) ---
# Calisan surum. Deploy'da docker-compose zaten E1_VERSION kullaniyor.
# apps/frontend-web/package.json "version" ile ayni tutulmali.
E1_VERSION=2.24.4
# Guncelleme kontrolu SADECE BILGI amaclidir; arayuzden guncelleme
# BASLATILAMAZ (guncelleme update.sh ile yapilir).
# Bos ise kontrol kapalidir. JSON bekler; surum su anahtarlarda aranir:
#   version | latest | tag_name        (GitHub Releases API de calisir)
# Ornek: https://releases.ornek.com/enerjione-grid/latest.json
UPDATE_CHECK_URL=
# Kontrol periyodu (saniye) - varsayilan 6 saat
UPDATE_CHECK_INTERVAL_SEC=21600

# --- Uzaktan bakim izni (Tailscale kapisi) ---
# Host'ta root ile calisan e1-rad ajani ile paylasilan dizin. Backend buraya
# SADECE request.json yazar; tailscale'i CALISTIRMAZ.
# Uzaktan erisim VARSAYILAN KAPALIDIR: musterinin yetkili kullanicisi
# (engineer rolu) arayuzden sureli izin verir, sure dolunca kendiliginden
# kapanir. Sureyi host ajani sayar (backend/DB kapali olsa bile).
# Dizin yoksa/yazilamiyorsa "Uzaktan Bakim" sayfasi bunu kullaniciya soyler
# (hata degil — tailscale kurulmamis kurulumda normal).
REMOTE_ACCESS_STATE_DIR=/var/lib/e1-grid/remote
# Bir uzaktan bakim izninin en fazla kac dakika surebilecegi (site tavani).
# Varsayilan 1440 = 24 saat. Arayuzdeki sure secenekleri bu tavana gore
# uretilir; daha kisa bir deger yazmak musteri tarafinda ust siniri dusurur.
REMOTE_ACCESS_MAX_MINUTES=1440

# --- NATS TLS (opsiyonel, VARSAYILAN KAPALI) ---
# NATS istemci portu (4222) tum arayuzlere aciktir ve gateway'ler ona parolayla
# baglanir. TLS olmadan HEM gateway parolasi HEM tum telemetri DUZ METIN gider;
# parolayi yakalayan biri sahte telemetri enjekte edebilir (uydurma ariza
# uretmek ya da gercek arizayi maskelemek).
#
# ACMA SIRASI — bu sirayla yapilmazsa telemetri DURUR:
#   1) sudo bash infra/scripts/linux/nats-tls-setup.sh [<disaridan-gorunen-adres>]
#   2) .env:  NATS_TLS_ENABLED=true
#             NATS_CA_FILE=/etc/nats/certs/ca.crt
#             NATS_URL=tls://<kullanici>:<parola>@nats:4222
#   3) sudo bash update.sh   (NATS ayari yeniden render edilir)
#   4) UZAKTAKI gateway'lere ca.crt kopyalanir ve ayni iki ayar verilir
#
# NATS_CA_FILE bos ise TLS kapalidir ve davranis bugunkuyle aynidir.
# NATS_TLS_ENABLED=false
# NATS_CA_FILE=

# --- FTP ---------------------------------------------------------------------
# Gomulu FTP sunucusunun health ucu. FTP ayarlari ekranindaki baglanti durumu
# paneli sunucunun ayakta olup olmadigini ve aktif kullanici adini buradan
# okur. Docker network icinde varsayilan dogrudur; degistirmek gerekmez.
# FTP_SERVER_HEALTH_URL=http://ftp-server:8015
