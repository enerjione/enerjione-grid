# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=hsl.events
RABBITMQ_DLX_EXCHANGE=hsl.events.dlx
IEC104_INCOMING_TOPIC=telemetry.received
IEC104_QUEUE=hsl.iec104_outbound.telemetry
IEC104_PREFETCH=50

# --- Backend-api ------------------------------------------------------------
BACKEND_API_BASE=http://127.0.0.1:8000/api/v1
INTERNAL_SERVICE_TOKEN=change-me-internal-token
IEC104_CATALOG_REFRESH_SEC=30

# --- Health -----------------------------------------------------------------
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8013

# --- IEC 104 ----------------------------------------------------------------
# Outbound target'in `listen_host` alani backend'de NULL ise asagidaki kullanilir.
IEC104_DEFAULT_LISTEN_HOST=0.0.0.0
IEC104_KEEPALIVE_SEC=20
