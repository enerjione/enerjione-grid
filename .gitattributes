# Auto detect text files and perform LF normalization
* text=auto

# Linux'ta calisacak shell scriptleri ve docker dosyalari mutlaka LF olmali —
# CRLF olursa "bash: bad interpreter" / "syntax error near unexpected token" verir.
*.sh         text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
docker-compose.yml text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
nginx.conf   text eol=lf
