#!/usr/bin/env bash
# ===========================================================================
# enerjione-grid — saha yonetim komutu
# ===========================================================================
# Paketle birlikte /usr/bin'e kurulur. Kurulumcunun ezberlemesi gereken
# tek komut budur; `docker compose` veya `systemctl` bilmesine gerek yok.
#
#   sudo enerjione-grid setup            ilk kurulum (anahtar sorar, imaj indirir)
#   sudo enerjione-grid update           en son yayina gec
#   sudo enerjione-grid update 2.24.4    belirli surume gec (geri alma dahil)
#   sudo enerjione-grid start|stop|restart
#        enerjione-grid status           servis + surum ozeti
#        enerjione-grid logs [servis]    canli log
#   sudo enerjione-grid backup           elle DB yedegi
#        enerjione-grid version
#        enerjione-grid help
# ===========================================================================

set -euo pipefail

APP_DIR="${E1_APP_DIR:-/opt/enerjione-grid}"
UNIT=enerjione-grid.service

# Ortak arayuz katmani (renkler, kutular, adim gostergesi). Pakette birlikte
# geliyor; yoksa komut yine calissin diye asgari yedekler tanimlanir.
if [[ -f "$APP_DIR/infra/scripts/linux/_lib.sh" ]]; then
  # shellcheck disable=SC1091
  source "$APP_DIR/infra/scripts/linux/_lib.sh"
else
  e1_info() { printf '  · %s\n' "$*"; }
  e1_ok()   { printf '  ✓ %s\n' "$*"; }
  e1_warn() { printf '  ! %s\n' "$*" >&2; }
  e1_err()  { printf '  ✗ %s\n' "$*" >&2; }
  e1_die()  { printf '\n  HATA: %b\n\n' "$*" >&2; exit 1; }
  e1_kv()   { printf '  %-18s %s\n' "$1" "$2"; }
fi

_need_root() {
  [[ $EUID -eq 0 ]] || e1_die "Bu komut root yetkisi ister:\n    sudo enerjione-grid $*"
}

_need_install() {
  [[ -f "$APP_DIR/docker-compose.yml" ]] \
    || e1_die "Kurulum bulunamadi ($APP_DIR).\n  Paket dogru kuruldu mu?  dpkg -l enerjione-grid"
}

_compose() { (cd "$APP_DIR" && docker compose "$@"); }

usage() {
  cat <<'USAGE'
EnerjiOne Grid — saha yonetim komutu

  sudo enerjione-grid setup             Ilk kurulum: anahtar sorar, imajlari
                                        indirir, sistemi baslatir
  sudo enerjione-grid update [surum]    Guncelle. Surum verilirse o surume
                                        gecer (GERI ALMA da budur)
  sudo enerjione-grid start             Baslat
  sudo enerjione-grid stop              Durdur
  sudo enerjione-grid restart           Yeniden baslat
       enerjione-grid status            Servis durumu + surum
       enerjione-grid logs [servis]     Canli log (Ctrl+C ile cik)
  sudo enerjione-grid backup            Elle veritabani yedegi
       enerjione-grid version           Kurulu surum
       enerjione-grid help              Bu ekran

Ornekler
  sudo enerjione-grid update            en son yayina gec
  sudo enerjione-grid update 2.24.4     2.24.4'e don (geri alma)
       enerjione-grid logs backend-api  sadece backend loglari
USAGE
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  setup)
    _need_root setup
    _need_install
    # Kurulumun tamami install.sh'te; burada onu cagiriyoruz ki tek bir
    # dogruluk kaynagi olsun (paket ve git kurulumu ayni kodu kossun).
    exec bash "$APP_DIR/install.sh" "$@"
    ;;

  update)
    _need_root update
    _need_install
    if [[ -n "${1:-}" ]]; then
      exec bash "$APP_DIR/update.sh" --version "$1" "${@:2}"
    fi
    exec bash "$APP_DIR/update.sh" "$@"
    ;;

  start)   _need_root start;   systemctl start   "$UNIT"; e1_ok "Baslatildi." ;;
  stop)    _need_root stop;    systemctl stop    "$UNIT"; e1_ok "Durduruldu." ;;
  restart) _need_root restart; systemctl restart "$UNIT"; e1_ok "Yeniden baslatildi." ;;

  status)
    _need_install
    e1_kv "Surum" "$(cat "$APP_DIR/VERSION" 2>/dev/null || echo '?')"
    e1_kv "Dizin" "$APP_DIR"
    if systemctl is-enabled --quiet "$UNIT" 2>/dev/null; then
      e1_kv "Acilista" "otomatik baslar"
    else
      e1_kv "Acilista" "OTOMATIK BASLAMAZ (sudo systemctl enable $UNIT)"
    fi
    echo
    _compose ps
    ;;

  logs)
    _need_install
    # --tail: bastan itibaren tum gecmisi dokmek yerine son 100 satir.
    _compose logs -f --tail 100 ${1:+"$1"}
    ;;

  backup)
    # BU KOMUT DISKI DOLDURUYORDU
    # ---------------------------
    # Eskiden `pg_dump | gzip > manual-*.sql.gz` idi: `--exclude-table-data`
    # YOK, yani 90 gunluk historian arsivinin TAMAMI her yedege giriyordu
    # (dosya basina birkac GB). Ustelik duz SQL oldugu icin UI'daki geri
    # yukleme `validate_dump_file`in PGDMP imza kontrolune takiliyordu — yani
    # dosyalar yalnizca yer kapliyordu.
    #
    # update.sh'taki ayni hata duzeltildi ama BU YOL atlanmisti; musteriye
    # verilen tek elle-yedek komutu buydu.
    _need_root backup
    _need_install
    cd "$APP_DIR"
    ts="$(date +%Y%m%d-%H%M%S)"
    mkdir -p backups

    # Bos alan kontrolu: yedek "iyi olsun diye" alinir, CALISAN sistemi
    # doldurmasi kabul edilemez.
    free_mb="$(df -Pm . 2>/dev/null | awk 'NR==2 {print $4}')"
    if [[ -n "${free_mb:-}" ]] && [[ "$free_mb" -lt 2048 ]]; then
      e1_die "Diskte yalnizca ${free_mb} MB bos alan var; yedek alinmadi.\n    Yer acin: sudo docker system prune -af"
    fi

    pg_user="$(sed -n 's/^POSTGRES_USER=//p' .env | tail -n1)"
    pg_db="$(sed -n 's/^POSTGRES_DB=//p' .env | tail -n1)"
    out="backups/manual-${ts}.dump"

    # -F c: custom format — UI'dan "Yedek Yukle" ile geri yuklenebilir.
    dump_args=(-U "${pg_user:-enerjione_grid}" -d "${pg_db:-enerjione_grid}"
               -F c --no-owner --no-acl)
    if declare -F e1_dump_exclude_into >/dev/null 2>&1; then
      e1_dump_exclude_into dump_args
    else
      # _lib.sh yoksa (beklenmez; pakette geliyor) en azindan en buyuk
      # kalemleri disarida birak — yoksa dosya GB'lara cikar.
      for _t in telemetry telemetry_history telemetry_history_1m \
                telemetry_history_1h processed_messages outbox_events \
                '_timescaledb_internal._hyper_*' \
                '_timescaledb_internal._materialized_hypertable_*'; do
        dump_args+=(--exclude-table-data "$_t")
      done
    fi

    if _compose exec -T postgres pg_dump "${dump_args[@]}" > "$out"; then
      e1_ok "Yedek alindi: ${APP_DIR}/${out} ($(du -h "$out" | cut -f1))"
      e1_info "Geri yukleme: Muhendislik > Sistem > Yedekler > Yedek Yukle"
      # Elle yedekler OTOMATIK SILINMEZ: operator bunlari genelde bilincli
      # alir ("buyuk degisiklik oncesi") ve habersiz kaybetmemeli — backend'in
      # `backup_manual_retention_days` varsayilani da 0'dir. Ama birikirse
      # haber ver.
      adet="$(find backups -maxdepth 1 -type f -name 'manual-*' 2>/dev/null | wc -l)"
      if [[ "${adet:-0}" -gt 5 ]]; then
        e1_warn "${adet} elle yedek birikmis (${APP_DIR}/backups). Gerekmeyenleri silin."
      fi
    else
      rm -f "$out"
      e1_die "Yedek alinamadi. Postgres ayakta mi?  enerjione-grid status"
    fi
    ;;

  version|--version|-v)
    cat "$APP_DIR/VERSION" 2>/dev/null || echo "?"
    ;;

  help|--help|-h) usage ;;
  *)
    e1_err "Bilinmeyen komut: $cmd"
    echo
    usage
    exit 1
    ;;
esac
